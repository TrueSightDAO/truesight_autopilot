[Unit]
Description=TrueSight Autopilot — Autonomous SRE + Developer
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/truesight_autopilot
Environment=PATH=/opt/truesight_autopilot/.venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/opt/truesight_autopilot/.env
# --workers 4, bumped 2026-10-29 by Envoy per governor go-ahead. Previously pinned to
# 1 because per-session state (locks, queues, live-progress) lived in module-level
# dicts, unsafe to fork across workers (bricked threads 3 and 780 on 2026-06-10).
# PRs #567/#569/#571/#573 moved locks/queues/cancel-flags/live-progress to shared
# Redis state, and SESSION_CLAIM_ENABLED=true (set in .env) activates the
# cross-process claim layer. Known residual risk, not yet addressed: the GitHub
# rate-limit semaphore (app/github_throttle.py) is still per-process, not a shared
# Redis budget. Also known: 9 singleton background loops (calendar watchdog, email
# watch, etc.) ran once per worker until app/singleton_guard.py (in progress) added
# a cross-process guard -- see agentic_ai_context/plans/SOPHIA_SIDEKIQ_MULTIPROCESS_PLAN.md
# and SOPHIA_MULTI_PROCESS_WORKER_PLAN.md (PR #1740). IMPORTANT: this file is the
# deploy source of truth (scripts/deploy.sh copies it over /etc/systemd/system/ on
# every deploy) -- editing only the live unit file does NOT persist past the next
# deploy from any thread. Rollback: git revert this file's change, or set --workers 1.
ExecStart=/opt/truesight_autopilot/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8001 --workers 4
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

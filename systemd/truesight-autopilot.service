[Unit]
Description=TrueSight Autopilot — Autonomous SRE + Developer
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/truesight_autopilot
Environment=PATH=/opt/truesight_autopilot/.venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/opt/truesight_autopilot/.env
# --workers 1 is REQUIRED until app/singleton_guard.py EXISTS. Verified 2026-10-29:
# that file is absent and referenced nowhere, so it does not guard anything.
# Without it, every worker runs its own copy of the lifespan background loops
# (app/main.py 711-804): email_watch + email_poller (both send OUTBOUND EMAIL),
# calendar_watchdog (sends nudges), aws_monitor, followup_loop, _context_sync_loop,
# _branch_janitor_loop, _pending_janitor_loop, _catalog_refresh_loop. At N workers
# that is N x duplicate outbound mail to real correspondents.
#
# Shared per-session state is DONE and no longer the blocker: PRs #567/#569/#571/#573
# moved locks / queues / cancel-flags / live-progress to Redis, gated by
# SESSION_STATE_SHARED=1 (set durably in .env) plus SESSION_CLAIM_ENABLED=true.
# Those are prerequisites for workers > 1, not sufficient on their own.
#
# Remaining blockers before bumping to 4:
#   1. app/singleton_guard.py with a real cross-process guard on all lifespan loops.
#      A previous revision of this comment claimed it had been added; it had not.
#   2. app/github_throttle.py is a per-process semaphore -- N workers each track
#      their own concurrency against one 5000/hr PAT. Needs a shared Redis budget.
#
# IMPORTANT: this file is the deploy source of truth (scripts/deploy.sh:315 copies
# it over /etc/systemd/system/ on EVERY deploy). Editing only the live unit file
# does NOT persist -- that is how the 2026-10-29 workers bump was silently reverted.
ExecStart=/opt/truesight_autopilot/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8001 --workers 1
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

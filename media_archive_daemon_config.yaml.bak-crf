# Captions / geo enrichment (farm_media_captions.py + farm_media_geo.py)
captions:
  model: base            # faster-whisper model: base | small | medium
  language: pt           # source audio language (task="translate" -> English)

geo:
  api_key_env: GOOGLE_MAPS_API_KEY   # Maps/Geocoding key (in /opt/truesight_autopilot/.env)
  cache_path: /tmp/farm_media_geo_cache.json   # dedupe cache (farms share GPS)
